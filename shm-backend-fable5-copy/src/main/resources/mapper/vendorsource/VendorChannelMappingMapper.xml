<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.shm.vendorsource.mapper.VendorChannelMappingMapper">

    <resultMap id="ChannelMappingResultMap" type="com.example.shm.vendorsource.entity.VendorChannelMappingEntity">
        <id column="id" property="id"/>
        <result column="source_type" property="sourceType"/>
        <result column="device_no" property="deviceNo"/>
        <result column="channel_no" property="channelNo"/>
        <result column="sensor_id" property="sensorId"/>
        <result column="module_key" property="moduleKey"/>
        <result column="sensor_name" property="sensorName"/>
        <result column="unit" property="unit"/>
        <result column="location" property="location"/>
        <result column="enabled" property="enabled"/>
        <result column="remark" property="remark"/>
    </resultMap>

    <sql id="mappingColumns">
        id, source_type, device_no, channel_no, sensor_id, module_key,
        sensor_name, unit, location, enabled, remark
    </sql>

    <select id="selectEnabledByChannel" resultMap="ChannelMappingResultMap">
        SELECT <include refid="mappingColumns"/>
        FROM vendor_channel_mapping
        WHERE deleted = 0
          AND enabled = 1
          AND source_type = #{sourceType}
          AND device_no = #{deviceNo}
          AND channel_no = #{channelNo}
        ORDER BY id ASC
        LIMIT 1
    </select>

    <select id="selectEnabledBySensorId" resultMap="ChannelMappingResultMap">
        SELECT <include refid="mappingColumns"/>
        FROM vendor_channel_mapping
        WHERE deleted = 0
          AND enabled = 1
          AND source_type = #{sourceType}
          AND sensor_id = #{sensorId}
        ORDER BY id ASC
        LIMIT 1
    </select>
</mapper>
