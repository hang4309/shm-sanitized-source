# SYNTHETIC local demonstration only; not loaded automatically.
# Export these in the shell that starts the backend. Do not commit real credentials.
SHM_DB_URL=jdbc:mysql://127.0.0.1:3306/shm_synthetic_demo?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC
SHM_DB_USERNAME=shm_demo
SHM_DB_PASSWORD=REPLACE_WITH_LOCAL_DEMO_PASSWORD
# Optional: exact socket IPs of reverse proxies that overwrite X-Real-IP.
# Leave empty for direct/loopback access. CIDR ranges are not accepted.
# SHM_RATE_LIMIT_TRUSTED_PROXY_IPS=127.0.0.1,10.0.0.5
